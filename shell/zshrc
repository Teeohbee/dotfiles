# =============================================
# OH MY ZSH CONFIGURATION
# =============================================
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# =============================================
# ZSH PLUGINS
# =============================================
plugins=(
    git
    z
)

source $ZSH/oh-my-zsh.sh

# =============================================
# CUSTOM FUNCTIONS
# =============================================
function github() {
  git_url=$(git config --get remote.origin.url)
  git_url=${git_url/git@github.com:/https://github.com/}
  git_url=${git_url/.git/\/tree/}
  branch_name=$(git symbolic-ref -q HEAD)
  branch_name=${branch_name##refs/heads/}
  branch_name=${branch_name:-HEAD}
  open "${git_url}${branch_name}"
}

# =============================================
# ALIASES
# =============================================
# Config/Environment
alias be="bundle exec"
alias zh="zed ~/.zshrc"
alias ghosttyc="zed ~/.config/ghostty/config"
alias src="source ~/.zshrc"

# System
alias ss="open -a ScreenSaverEngine.app"
alias slp="pmset sleepnow"
alias launchpad="defaults write com.apple.dock ResetLaunchPad -bool true; killall Dock"
alias gitbr='git rev-parse --abbrev-ref HEAD | pbcopy'
alias cwd='pwd | pbcopy'

# Claude Code
alias claude-config="zed ~/.claude"

# Godot
gut() {
  godot --headless -s addons/gut/gut_cmdln.gd ${1:+-gtest=$1} -gdir=res://tests -ginclude_subdirs -gexit 2>&1
}

# =============================================
# DEVELOPMENT ENVIRONMENT
# =============================================
# Ruby environment
eval "$(rbenv init -)"

# Node Version Manager
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# =============================================
# ENVIRONMENT VARIABLES
# =============================================
export PATH="$(brew --prefix)/sbin:$PATH"
export PATH="$PATH:/opt/homebrew/opt/coreutils/libexec/gnubin"
export PATH="$HOME/.local/bin:$PATH"
export PACT_DO_NOT_TRACK=true
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_AUTO_UPDATE=1

# Source work-specific config if it exists
[[ -f ~/.zshrc.work ]] && source ~/.zshrc.work
